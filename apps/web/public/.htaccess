<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Files>
</IfModule>

RewriteEngine On
RewriteRule ^api/ - [L]

# Missing hashed assets must 404. Rewriting them to index.html makes
# Googlebot execute HTML as JavaScript and screenshot a black empty page.
RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|txt|xml|json|webmanifest)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
