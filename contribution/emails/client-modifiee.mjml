<mjml>
  <mj-head>
    <mj-preview>Votre réservation a été modifiée.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Georgia, serif" />
      <mj-text color="#e8dcc8" font-size="16px" line-height="1.55" padding="8px 24px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#1a1612">
    <mj-wrapper padding="48px 20px">
      <mj-hero
        mode="fixed-height"
        height="469px"
        background-width="600px"
        background-height="469px"
        background-url="{image_salle}"
        background-color="#2a3448"
        padding="0px">
        <mj-image
          src="{logo}"
          alt="{logo_alt}"
          width="160px"
          height="160px"
          border-radius="80px"
          align="center"
          padding="128px 20px 16px"
          href="{site}"
        />
        <mj-text
          padding="20px"
          color="#ffffff"
          font-family="Helvetica"
          align="center"
          font-size="45px"
          line-height="45px"
          font-weight="900">
          RÉSERVATION <br />
          MODIFIÉE
        </mj-text>
      </mj-hero>
      <mj-section background-color="#241f1a" padding="0">
        <mj-column padding="0">
          <mj-text font-size="22px" color="#f4ead6" padding="24px 24px 12px">Bonjour {nom},</mj-text>
          <mj-text padding="0 24px 12px">Votre réservation a été modifiée. Voici les nouveaux détails :</mj-text>
          <mj-text padding="0 24px 12px">
            Salle : {salle}<br />
            Date : {date}<br />
            Heure : {heure}<br />
            Durée : {duree} minutes<br />
            Joueurs : {joueurs}
          </mj-text>
          <mj-text padding="0 24px 12px">Merci d'arriver 15 minutes avant le début de la session une fois la réservation confirmée.</mj-text>
          <mj-text padding="0 24px 12px">Adresse : {adresse}</mj-text>
          <mj-text padding="0 24px 12px">
            Ajoutez l'événement à votre calendrier : fichier joint (reservation.ics) ou téléchargement : {lien_ics}
          </mj-text>
          <mj-text padding="0 24px 32px">À très bientôt,<br />L'équipe Escape Occitanie</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
